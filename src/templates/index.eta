<h1>VersaTiles Playground</h1>

<p>Here are some examples showing how to use VersaTiles in the frontend:</p>

<% it.groups.forEach(({title,examples}) => { %>
<h2><%= title %></h2>

<% examples.forEach(example => { %>
<div class="vp-example">
	<div class="vp-example-text">
		<h3><a href="<%~ example.slug %>/"><%= example.title %></a></h3>
		<p><a href="<%~ example.slug %>/"><%= example.description %></a></p>
	</div>
	<div class="vp-example-preview">
		<a href="<%~ example.slug %>/">
			<img src="<%~ example.slug %>/preview.png" alt="<%= example.title %>" width="320" height="180" />
		</a>
	</div>
</div>
<% }) %>
<% }) %>